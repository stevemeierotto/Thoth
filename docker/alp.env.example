# Optional ALP1 flags for thoth-engine (Docker or host).
# Copy to .env or export before: docker compose up -d
#
# Inference / embedding: see docker/embed.env.example (THOTH_INFERENCE_BACKEND=llama_cpp).
#
# Brownfield: run ALP-D1 first; do NOT set GREENFIELD.
# Greenfield / certification: empty workspace + GREENFIELD=1.

THOTH_ALP_ENABLED=1
THOTH_ALP_TX_INDEX=1
THOTH_ALP_GUI=1
THOTH_ALP_GREENFIELD=1
