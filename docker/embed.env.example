# Thoth Docker / host — llama.cpp inference + embedding (default stack)
# Copy relevant lines to repo-root .env before: docker compose up -d
#
# Chat and embeddings use separate llama.cpp servers (see docker-compose.yml).
# Ollama is optional — do not set THOTH_INFERENCE_BACKEND=ollama unless using Ollama.

# Backend selector (required for Compose llama.cpp stack)
THOTH_INFERENCE_BACKEND=llama_cpp

# Published Engine port on host
THOTH_ENGINE_PUBLISH_PORT=8090

# llama.cpp service URLs — set by docker-compose.yml inside the stack.
# Host-native engine talking to local llama servers:
# THOTH_INFERENCE_BASE_URL=http://127.0.0.1:8080
# THOTH_EMBED_BASE_URL=http://127.0.0.1:8081

# GGUF paths inside llama-models volume
LLAMA_CHAT_MODEL=/models/chat.gguf
LLAMA_EMBED_MODEL=/models/nomic-embed-text.gguf

# API model names passed to llama-server /v1/* endpoints
OLLAMA_MODEL=chat
OLLAMA_EMBED_MODEL=nomic-embed-text

# Startup diagnostics (logs resolved inference/embed URLs)
THOTH_LOG_CONFIG=1

# After embed_probe=ok is stable, enable to disable silent TF-IDF fallback:
# THOTH_EMBED_STRICT=1

# Remote GUI → Docker Engine
# THOTH_ENGINE_URL=http://127.0.0.1:8090
